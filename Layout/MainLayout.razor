@inherits LayoutComponentBase

<div class="site-wrapper">
    <NavMenu OnOpenQuoteModal="OpenQuoteModal" />

    <main class="site-main" role="main">
        @Body
    </main>

    <Footer />

    <QuoteModal @bind-IsOpen="_isQuoteModalOpen" />
    <ToastContainer />
    <WhatsAppButton />
</div>

@code {
    private bool _isQuoteModalOpen = false;

    private void OpenQuoteModal()
    {
        _isQuoteModalOpen = true;
    }
}
