@inject IContentService ContentService

<footer class="site-footer">
    <div class="container">
        <div class="footer-grid">
            <!-- Brand Column -->
            <div class="footer-col brand-col">
                <Logo IsDarkTheme="true" Width="150" ShowTagline="false" />
                <p class="footer-desc">
                    @(_company?.ShortDescription ?? "BlueGridSolutions delivers world-class luxury property management, tenant placement, and preventative maintenance coordination for premier real estate assets.")
                </p>
                <div class="footer-socials">
                    <a href="@(_company?.Socials?.LinkedIn ?? "https://linkedin.com")" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.64 1.64 0 1 0 0 3.28 1.64 1.64 0 0 0 0-3.28z"/></svg>
                    </a>
                    <a href="@(_company?.Socials?.Instagram ?? "https://instagram.com")" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                    </a>
                    <a href="@(_company?.Socials?.Facebook ?? "https://facebook.com")" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="social-icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.5 5H18V0h-3.808C10.595 0 9 1.582 9 4.615V8z"/></svg>
                    </a>
                </div>
            </div>

            <!-- Quick Navigation -->
            <div class="footer-col nav-col">
                <h4 class="footer-heading">Navigation</h4>
                <ul class="footer-links">
                    <li><NavLink href="" Match="NavLinkMatch.All" class="footer-nav-link">Home Portfolio</NavLink></li>
                    <li><NavLink href="about" class="footer-nav-link">Company & Team</NavLink></li>
                    <li><NavLink href="services" class="footer-nav-link">Management Services</NavLink></li>
                    <li><NavLink href="projects" class="footer-nav-link">Managed Assets</NavLink></li>
                    <li><NavLink href="contact" class="footer-nav-link">Investor Contact</NavLink></li>
                </ul>
            </div>

            <!-- Services -->
            <div class="footer-col services-col">
                <h4 class="footer-heading">Services</h4>
                <ul class="footer-links">
                    <li><NavLink href="services#full-property-management" class="footer-nav-link">Full Property Management</NavLink></li>
                    <li><NavLink href="services#tenant-placement" class="footer-nav-link">Tenant Placement & Screening</NavLink></li>
                    <li><NavLink href="services#maintenance-coordination" class="footer-nav-link">24/7 Preventative Care</NavLink></li>
                    <li><NavLink href="services#financial-reporting" class="footer-nav-link">Financial Stewardship</NavLink></li>
                    <li><NavLink href="services#commercial-facility" class="footer-nav-link">Commercial Facility Care</NavLink></li>
                </ul>
            </div>

            <!-- Contact & Office -->
            <div class="footer-col contact-col">
                <h4 class="footer-heading">Contact & Concierge</h4>
                <div class="footer-contact-info">
                    <p class="contact-item">
                        <span class="contact-icon">📍</span>
                        <span>@(_company?.Contact?.OfficeAddress ?? "850 Ocean View Boulevard, Suite 1400")<br />@(_company?.Contact?.CityStateZip ?? "Marina Bay, CA 90292")</span>
                    </p>
                    <p class="contact-item">
                        <span class="contact-icon">📞</span>
                        <a href="tel:@(_company?.Contact?.Phone ?? "+18005842970")">@(_company?.Contact?.Phone ?? "+1 (800) 584-2970")</a>
                    </p>
                    <p class="contact-item">
                        <span class="contact-icon">✉️</span>
                        <a href="mailto:@(_company?.Contact?.Email ?? "inquiries@bluegridsolutions.com")">@(_company?.Contact?.Email ?? "inquiries@bluegridsolutions.com")</a>
                    </p>
                    <p class="contact-item">
                        <span class="contact-icon">🕒</span>
                        <span>@(_company?.Contact?.OperatingHours ?? "Mon – Fri: 08:00 – 18:00 | 24/7 Dispatch")</span>
                    </p>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; @DateTime.Now.Year BlueGridSolutions Inc. All rights reserved. Precision Property Management & Luxury Asset Stewardship.</p>
            <div class="footer-legal">
                <span>Equal Housing Opportunity</span>
                <span>•</span>
                <span>Licensed Real Estate Brokerage</span>
            </div>
        </div>
    </div>
</footer>
@code {
    private CompanyInfo? _company;

    protected override async Task OnInitializedAsync()
    {
        _company = await ContentService.GetCompanyInfoAsync();
    }
}
