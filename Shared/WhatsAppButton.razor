       target="_blank" 
       rel="noopener noreferrer" 
       class="whatsapp-float animate-pulse-gold" 
       aria-label="Chat with our property concierge on WhatsApp">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12.031 0C5.396 0 .029 5.367.029 12.002c0 2.119.553 4.185 1.603 6.009L0 24l6.169-1.619a11.96 11.96 0 0 0 5.862 1.52h.005c6.633 0 12.001-5.367 12.001-12.002C24.037 5.367 18.667 0 12.031 0zm0 21.967h-.004a9.94 9.94 0 0 1-5.074-1.39l-.364-.216-3.769.988 1.006-3.673-.238-.378a9.927 9.927 0 0 1-1.527-5.296C3.06 7.07 7.086 3.044 12.035 3.044c2.41 0 4.676.938 6.381 2.645a9.887 9.887 0 0 1 2.645 6.381c-.002 4.949-4.029 8.897-9.03 8.897zm5.45-7.464c-.299-.149-1.77-.873-2.044-.972-.274-.1-.473-.149-.672.149-.199.299-.772.972-.946 1.171-.174.199-.348.224-.647.075-.299-.149-1.262-.465-2.404-1.484-.888-.793-1.488-1.772-1.662-2.071-.174-.299-.019-.46.13-.609.135-.134.299-.348.448-.523.149-.174.199-.299.299-.498.1-.199.05-.373-.025-.523-.075-.149-.672-1.62-.921-2.217-.243-.583-.49-.504-.672-.513-.174-.009-.373-.01-.573-.01s-.523.075-.797.373c-.274.299-1.045 1.021-1.045 2.49 0 1.469 1.07 2.888 1.22 3.087.149.199 2.106 3.216 5.102 4.51.713.308 1.27.493 1.704.63.716.228 1.368.196 1.883.119.575-.086 1.77-.723 2.02-1.42.249-.697.249-1.295.174-1.42-.075-.125-.274-.199-.573-.348z"/>
        </svg>
        <span class="whatsapp-tooltip">Chat with Concierge</span>
    </a>
}

@code {
    private CompanyInfo? _company;

    protected override async Task OnInitializedAsync()
    {
        _company = await ContentService.GetCompanyInfoAsync();
    }
}
