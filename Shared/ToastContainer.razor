@inject INotificationService NotificationService
@implements IDisposable

<div class="toast-container" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="toast-item animate-toast @GetToastClass(toast.Type)" role="alert" key="@toast.Id">
            <div class="toast-icon">
                @switch (toast.Type)
                {
                    case ToastType.Success:
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        break;
                    case ToastType.Error:
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="15" y1="9" x2="9" y2="15"></line>
                            <line x1="9" y1="9" x2="15" y2="15"></line>
                        </svg>
                        break;
                    case ToastType.Warning:
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                        break;
                    default:
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C5A880" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        break;
                }
            </div>
            <div class="toast-content">
                @if (!string.IsNullOrWhiteSpace(toast.Title))
                {
                    <div class="toast-title">@toast.Title</div>
                }
                <div class="toast-message">@toast.Message</div>
            </div>
            <button type="button" class="toast-close" @onclick="() => DismissToast(toast.Id)" aria-label="Close notification">
                &times;
            </button>
        </div>
    }
</div>

@code {
    private readonly List<ToastMessage> _toasts = new();

    protected override void OnInitialized()
    {
        NotificationService.OnShow += HandleShowToast;
        NotificationService.OnHide += HandleHideToast;
    }

    private void HandleShowToast(ToastMessage toast)
    {
        InvokeAsync(async () =>
        {
            _toasts.Add(toast);
            StateHasChanged();

            if (toast.DurationMs > 0)
            {
                await Task.Delay(toast.DurationMs);
                DismissToast(toast.Id);
            }
        });
    }

    private void HandleHideToast(string id)
    {
        InvokeAsync(() =>
        {
            DismissToast(id);
        });
    }

    private void DismissToast(string id)
    {
        var item = _toasts.FirstOrDefault(t => t.Id == id);
        if (item != null)
        {
            _toasts.Remove(item);
            StateHasChanged();
        }
    }

    private string GetToastClass(ToastType type) => type switch
    {
        ToastType.Success => "toast-success",
        ToastType.Error => "toast-error",
        ToastType.Warning => "toast-warning",
        _ => "toast-info"
    };

    public void Dispose()
    {
        NotificationService.OnShow -= HandleShowToast;
        NotificationService.OnHide -= HandleHideToast;
    }
}
