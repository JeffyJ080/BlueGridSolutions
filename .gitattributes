# Auto-detect text files and perform LF normalization
* text=auto

# Source code and config files
*.cs text diff=csharp
*.razor text
*.html text
*.css text
*.js text
*.json text
*.xml text
*.config text
*.md text

# MSBuild and Visual Studio files
*.sln text eol=crlf
*.csproj text
*.props text
*.targets text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wasm binary
*.dll binary
*.pdb binary
