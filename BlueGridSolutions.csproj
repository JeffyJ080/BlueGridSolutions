<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.11" PrivateAssets="all" />
  </ItemGroup>

  <!-- Path normalization only needed when running inside Linux dev containers mounted from Windows hosts -->
  <Target Name="FixGeneratedEditorConfigFile" 
          AfterTargets="GenerateMSBuildEditorConfigFileCore" 
          BeforeTargets="CoreCompile"
          Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Exec Command="sed -i 's|\\|/|g' &quot;$(GeneratedMSBuildEditorConfigFile)&quot;" Condition="Exists('$(GeneratedMSBuildEditorConfigFile)')" />
    <Exec Command="sed -i -E 's|\[.*workspace/|[/workspace/|g' &quot;$(GeneratedMSBuildEditorConfigFile)&quot;" Condition="Exists('$(GeneratedMSBuildEditorConfigFile)')" />
  </Target>

</Project>
