<div class="luxury-card service-card @(Service.IsPopular ? "popular-card" : "")" id="@Service.Id">
    <div class="service-card-header">
        <div class="service-icon-box">
            @switch (Service.Icon.ToLowerInvariant())
            {
                case "building":
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
                        <line x1="9" y1="22" x2="9" y2="2"></line>
                        <line x1="15" y1="22" x2="15" y2="2"></line>
                        <line x1="4" y1="6" x2="20" y2="6"></line>
                        <line x1="4" y1="10" x2="20" y2="10"></line>
                        <line x1="4" y1="14" x2="20" y2="14"></line>
                        <line x1="4" y1="18" x2="20" y2="18"></line>
                    </svg>
                    break;
                case "users":
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                    break;
                case "wrench":
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                    </svg>
                    break;
                case "chart-line":
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="20" x2="18" y2="10"></line>
                        <line x1="12" y1="20" x2="12" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="14"></line>
                        <line x1="2" y1="20" x2="22" y2="20"></line>
                    </svg>
                    break;
                case "briefcase":
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                    </svg>
                    break;
                default:
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="16 18 22 12 16 6"></polyline>
                        <polyline points="8 6 2 12 8 18"></polyline>
                    </svg>
                    break;
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Service.Badge))
        {
            <span class="badge-gold-solid">@Service.Badge</span>
        }
    </div>

    <h3 class="service-title">@Service.Title</h3>
    <p class="service-tagline">@Service.Tagline</p>
    <p class="service-summary">@Service.Summary</p>

    @if (Service.KeyFeatures.Any())
    {
        <div class="service-features">
            <h4 class="features-label">Key Capabilities</h4>
            <ul class="features-list">
                @foreach (var feature in Service.KeyFeatures)
                {
                    <li>
                        <span class="check-icon">✓</span>
                        <span>@feature</span>
                    </li>
                }
            </ul>
        </div>
    }

    <div class="service-footer">
        <button type="button" class="btn btn-outline-gold w-100" @onclick="() => OnRequestQuote.InvokeAsync(Service)">
            <span>Inquire About Service</span>
        </button>
    </div>
</div>

<style>
.service-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    border: 1px solid rgba(226, 232, 240, 0.85);
    padding: 2rem 1.85rem;
}

.service-card.popular-card {
    border-color: var(--luxury-gold);
    box-shadow: 0 10px 30px rgba(197, 168, 128, 0.15);
}

.service-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
}

.service-icon-box {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background-color: var(--primary-navy);
    color: var(--luxury-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-sm);
}

.service-title {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
    color: var(--primary-navy);
}

.service-tagline {
    font-size: 0.84rem;
    color: var(--luxury-gold-dark);
    font-weight: 600;
    margin-bottom: 0.85rem;
}

.service-summary {
    font-size: 0.88rem;
    color: #475569;
    line-height: 1.6;
    margin-bottom: 1.25rem;
}

.service-features {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
    margin-bottom: 1.25rem;
}

.features-label {
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-navy);
    margin-bottom: 0.65rem;
}

.features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.features-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.84rem;
    color: #334155;
    line-height: 1.45;
}

.check-icon {
    color: var(--luxury-gold-dark);
    font-weight: 700;
    line-height: 1.2;
}

.service-footer {
    margin-top: 0.25rem;
}
</style>

@code {
    [Parameter] public ServiceItem Service { get; set; } = new();
    [Parameter] public EventCallback<ServiceItem> OnRequestQuote { get; set; }
}
