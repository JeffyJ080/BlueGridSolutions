<div class="property-filter-container">
    <!-- Top Row: Search Input & Status Selector -->
    <div class="filter-top-row">
        <div class="filter-search-box">
            <span class="search-icon">🔍</span>
            <input type="text" 
                   class="search-input" 
                   placeholder="Search by city, title, or keyword..." 
                   value="@SearchTerm" 
                   @oninput="HandleSearchInput" />
            @if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                <button type="button" class="clear-search-btn" @onclick="ClearSearch">&times;</button>
            }
        </div>

        <div class="filter-status-group">
            <span class="filter-label">Status:</span>
            <div class="status-pills">
                @foreach (var status in _statuses)
                {
                    <button type="button" 
                            class="status-pill @(SelectedStatus == status ? "active" : "")" 
                            @onclick="() => SetStatus(status)">
                        @status
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Bottom Row: Category Tabs -->
    <div class="filter-category-row">
        <span class="filter-label">Category:</span>
        <div class="category-tabs">
            @foreach (var category in _categories)
            {
                <button type="button" 
                        class="category-tab @(SelectedCategory == category ? "active" : "")" 
                        @onclick="() => SetCategory(category)">
                    @category
                </button>
            }
        </div>
    </div>
</div>

<style>
.property-filter-container {
    background-color: var(--pure-white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
}

.filter-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
}

.filter-search-box {
    position: relative;
    flex: 1;
    min-width: 260px;
    display: flex;
    align-items: center;
}

.search-icon {
    position: absolute;
    left: 1rem;
    font-size: 0.95rem;
    color: #94A3B8;
    pointer-events: none;
}

.search-input {
    width: 100%;
    padding: 0.75rem 2.5rem 0.75rem 2.8rem;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-md);
    outline: none;
    transition: all var(--transition-fast);
}

.search-input:focus {
    border-color: var(--luxury-gold);
    box-shadow: 0 0 0 3px rgba(197, 168, 128, 0.15);
}

.clear-search-btn {
    position: absolute;
    right: 0.75rem;
    background: transparent;
    border: none;
    font-size: 1.25rem;
    color: #94A3B8;
    cursor: pointer;
}

.filter-status-group, .filter-category-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
}

.filter-label {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--primary-navy);
}

.status-pills, .category-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
}

.status-pill, .category-tab {
    background-color: var(--off-white);
    border: 1px solid var(--border-light);
    color: #475569;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--transition-fast);
}

.status-pill:hover, .category-tab:hover {
    border-color: var(--luxury-gold-border);
    color: var(--primary-navy);
}

.status-pill.active, .category-tab.active {
    background-color: var(--primary-navy);
    color: var(--pure-white);
    border-color: var(--primary-navy);
    box-shadow: 0 4px 12px rgba(11, 31, 58, 0.15);
}

.category-tab.active {
    background: linear-gradient(135deg, var(--primary-navy) 0%, var(--secondary-navy) 100%);
    border-color: var(--luxury-gold);
}
</style>

@code {
    [Parameter] public string SelectedCategory { get; set; } = "All";
    [Parameter] public EventCallback<string> SelectedCategoryChanged { get; set; }

    [Parameter] public string SelectedStatus { get; set; } = "All";
    [Parameter] public EventCallback<string> SelectedStatusChanged { get; set; }

    [Parameter] public string SearchTerm { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SearchTermChanged { get; set; }

    private readonly List<string> _categories = new()
    {
        "All", "Executive Villa", "Luxury Residential", "Modern Apartment", "Commercial Asset"
    };

    private readonly List<string> _statuses = new()
    {
        "All", "Available", "Leased", "Under Management"
    };

    private async Task SetCategory(string category)
    {
        SelectedCategory = category;
        await SelectedCategoryChanged.InvokeAsync(category);
    }

    private async Task SetStatus(string status)
    {
        SelectedStatus = status;
        await SelectedStatusChanged.InvokeAsync(status);
    }

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? string.Empty;
        await SearchTermChanged.InvokeAsync(SearchTerm);
    }

    private async Task ClearSearch()
    {
        SearchTerm = string.Empty;
        await SearchTermChanged.InvokeAsync(string.Empty);
    }
}
